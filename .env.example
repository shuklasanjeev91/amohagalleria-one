# Dashboard setup for email OTP:
# Authentication → Email Templates → Magic Link must include {{ .Token }}
# Site URL: http://127.0.0.1:8081
# First admin: set app_metadata.role = "admin" for your user (SQL or Auth Admin API)
#
# Auth auto-register:
# Authentication → Providers → Email → enable “Allow new users to sign up”
# OTP with shouldCreateUser creates auth.users; DB trigger creates profiles as collector
